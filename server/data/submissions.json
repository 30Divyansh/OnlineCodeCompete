    "code": "def coinChange(coins: list[int], amount: int) -> int:\n    dp = [amount + 1] * (amount + 1)\n\n    dp[0] = 0\n\n    for i in range(1, amount + 1):\n        for j in range(len(coins)):\n\n            if coins[j] <= i:\n                dp[i] = min(dp[i], 1 + dp[i - coins[j]])\n\n    if dp[amount] == amount + 1:\n        return -1\n\n    return dp[amount]",
